# =============================================================================
# ATLAS Web Console — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# See docs/guides/deployment.md for full documentation.
# =============================================================================

# --- Backend Connection ---

# Server-side only: URL the Next.js rewrite proxy uses to reach ATLAS Core.
# Takes priority over NEXT_PUBLIC_ATLAS_API_URL for HTTP rewrites.
# ATLAS_BACKEND_URL=http://127.0.0.1:8000

# Shared (server + client): Base URL for ATLAS Core.
# - Server: fallback for HTTP rewrites if ATLAS_BACKEND_URL is not set.
# - Client: used to derive WebSocket URLs (ws:// / wss://).
# - Baked into the JS bundle at build time (NEXT_PUBLIC_ prefix).
# NEXT_PUBLIC_ATLAS_API_URL=http://127.0.0.1:8000

# --- API Keys (all optional) ---

# OpenAI — WebRTC voice relay
# OPENAI_API_KEY=sk-...

# ElevenLabs — real-time STT (Scribe v2) and TTS (Turbo v2.5)
# ELEVENLABS_API_KEY=sk_...
# NEXT_PUBLIC_ELEVENLABS_API_KEY=sk_...

# Anthropic Claude — LLM provider
# ANTHROPIC_API_KEY=sk-ant-...

# Cartesia Sonic 3 — alternative TTS
# CARTESIA_API_KEY=sk_car_...

# Pinecone — semantic vector memory
# PINECONE_API_KEY=pcsk_...
# PINECONE_INDEX=atlas-semantic-v1

# Groq — alternative LLM inference
# GROQ_API_KEY=gsk_...

# --- Feature Flags ---

# ATLAS_SEMANTIC_BACKEND=pinecone
# ATLAS_EMBEDDING_DIM=1536
# ATLAS_ANALYSIS_LOCAL=1

# Lucidchart integration (auto-generated architecture diagrams)
# LUCIDCHART_API_KEY=key-...
# LUCIDCHART_ENABLED=true
# LUCIDCHART_AUTO_EXPORT=true
# LUCIDCHART_EXPORT_FORMAT=png
